<Window x:Class="_7_Formulario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_7_Formulario"
        mc:Ignorable="d"
        Title="4 Formulario" Height="450" Width="800">
    <Grid ColumnDefinitions="2*,1*" RowDefinitions="Auto,Auto,Auto,1*,Auto">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Style="{StaticResource Titulo}">
            Formulario
        </TextBlock>
        <Border Grid.Row="1" Grid.Column="0"
                Style="{StaticResource CajaFormulario}"
                Background="LightSkyBlue">
            <StackPanel>
                <Grid ColumnDefinitions="60,*,2,Auto" Style="{StaticResource FilaFormulario}">
                    <TextBlock Grid.Column="0">Nombre</TextBlock>
                    <TextBox Grid.Column="1"/>
                    <Image Grid.Column="3" Style="{StaticResource InfoIcon}" ToolTip="Esto es el nombre"/>
                </Grid>
                <Grid ColumnDefinitions="60,*,2,Auto" Style="{StaticResource FilaFormulario}">
                    <TextBlock Grid.Column="0">Edad</TextBlock>
                    <TextBox Grid.Column="1"/>
                    <Image Grid.Column="3" Style="{StaticResource InfoIcon}" ToolTip="Esto es la edad"/>
                </Grid>
                <Grid ColumnDefinitions="60,*,2,Auto" Style="{StaticResource FilaFormulario}">
                    <TextBlock Grid.Column="0">Direccion</TextBlock>
                    <TextBox Grid.Column="1"/>
                    <Image Grid.Column="3" Style="{StaticResource InfoIcon}" ToolTip="Esto es la direccion"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.Column="0"
                Style="{StaticResource CajaFormulario}"
                Background="Beige">
            <StackPanel Orientation="Horizontal">
                <GroupBox Header="Aficiones">
                    <StackPanel Margin="8">
                        <CheckBox>Hacer deporte</CheckBox>
                        <CheckBox>Viajar</CheckBox>
                        <CheckBox>Ver series</CheckBox>
                        <CheckBox>Leer comics</CheckBox>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Estado civil">
                    <StackPanel Margin="8">
                        <RadioButton>Soltero</RadioButton>
                        <RadioButton>Casado</RadioButton>
                        <RadioButton>Divorciado</RadioButton>
                        <RadioButton>Viudo</RadioButton>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Border>
        <Image Grid.Row="1" Grid.RowSpan="3" Grid.Column="1"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Creditos}">Álvaro Monsonís Mas</TextBlock>
        <StackPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource StackPanelBotones}">
            <Button Style="{StaticResource ActionButton}">Aceptar</Button>
            <Button Style="{StaticResource ActionButton}">Cancelar</Button>
        </StackPanel>
    </Grid>
</Window>
