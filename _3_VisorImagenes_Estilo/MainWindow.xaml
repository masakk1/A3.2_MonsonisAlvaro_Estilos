<Window x:Class="_4_VisorImagenes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_4_VisorImagenes"
        mc:Ignorable="d"
        Title="3 Visor Imagenes" Height="425" Width="700">
    <Window.Resources>
        <Style TargetType="StackPanel" x:Key="StackPanelCreditos">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Background" Value="LightBlue"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Rubik"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="20"></Setter>
        </Style>
        <Style TargetType="Border" x:Key="BorderPanel">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="LightGreen"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="100"/>
        </Style>
        <Style TargetType="Image">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="100"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource StackPanelCreditos}">
            <Label>N de imagenes: 10</Label>
            <Label>Diseñado por Alvaro Monsonis</Label>
        </StackPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource BorderPanel}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <Button>Añadir imagen</Button>
                    <Button>Eliminar imagen</Button>
                    <Button>Eliminar todas</Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button>Rotar</Button>
                    <Button>Recortar</Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel>
            <Label>Visor de imagenes</Label>
            <WrapPanel>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
                <Image Source="Assets/espanita.webp"/>
            </WrapPanel>
        </StackPanel>
    </DockPanel>
</Window>
