<Window x:Class="_4_VisorImagenes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_4_VisorImagenes"
        mc:Ignorable="d"
        Title="4 Visor Imagenes" Height="425" Width="700">
    <DockPanel>
        <StackPanel Margin="10" DockPanel.Dock="Bottom" Background="LightBlue" Orientation="Horizontal">
            <Label Margin="5" FontFamily="Rubik" FontSize="20">N de imagenes: 10</Label>
            <Label Margin="5" FontFamily="Rubik" FontSize="20">Diseñado por Alvaro Monsonis</Label>
        </StackPanel>
        <Border BorderBrush="Black" BorderThickness="3" CornerRadius="8" Margin="10" DockPanel.Dock="Right" Background="LightGreen">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <Button Margin="5" Width="100">Añadir imagen</Button>
                    <Button Margin="5" Width="100">Eliminar imagen</Button>
                    <Button Margin="5" Width="100">Eliminar todas</Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Margin="5" Width="100">Rotar</Button>
                    <Button Margin="5" Width="100">Recortar</Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel>
            <Label FontFamily="Rubik" HorizontalAlignment="Center" FontSize="40">Visor de imagenes</Label>
            <WrapPanel>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
                <Image Margin="5" Source="Assets/espanita.webp" Width="120"/>
            </WrapPanel>
        </StackPanel>
    </DockPanel>
</Window>
