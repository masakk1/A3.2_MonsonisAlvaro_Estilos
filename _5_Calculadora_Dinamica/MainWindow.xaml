<Window x:Class="_5_Calculadora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_5_Calculadora"
        mc:Ignorable="d"
        Title="5 Calculadora" Height="400" Width="250">
    <Window.Resources>
        <Style TargetType="Border" x:Key="Border">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>
        <Style TargetType="Button" x:Key="NumberButton">
            <Setter Property="Margin" Value="1"></Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="NumberButtonText">
            <Setter Property="Margin" Value="5"></Setter>
        </Style>
    </Window.Resources>
    <Grid RowDefinitions="1*,2*,Auto">
        <Border Margin="1" Grid.Row="0">
            <Viewbox HorizontalAlignment="Right">
                <TextBlock x:Name="textBoxNumeros" />
            </Viewbox>
        </Border>

        <Grid x:Name="Botonera" Grid.Row="1"
              ColumnDefinitions="1*,1*,1*" RowDefinitions="1*,1*,1*"
              HorizontalAlignment="Stretch"/>
        <Button Tag="0" Click="Button_OnClick" Style="{StaticResource NumberButton}" Grid.Row="2">
            <TextBlock Style="{StaticResource NumberButtonText}">0</TextBlock>
        </Button>
    </Grid>
</Window>
