<Window x:Class="_2_EquiposNBA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2_EquiposNBA"
        mc:Ignorable="d"
        Title="2 Equipos NBA" Height="450" Width="900">
    <StackPanel>
        <Border BorderBrush="Black" BorderThickness="3" Margin="10" CornerRadius="3">
            <StackPanel>
                <Label HorizontalAlignment="Center" FontWeight="Bold" FontSize="30">Los Angeles Lakers</Label>
                <WrapPanel ItemHeight="125">
                    <Image Stretch="Uniform" Source="Assets/3_lakers.png"/>
                    <Image Stretch="Uniform" Source="Assets/9_lakers.png"/>
                    <Image Stretch="Uniform" Source="Assets/14_lakers.png"/>
                    <Image Stretch="Uniform" Source="Assets/23_lakers.png"/>
                    <Image Stretch="Uniform" Source="Assets/39_lakers.png"/>
                </WrapPanel>
                <StackPanel.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="MediumPurple" Offset="0"></GradientStop>
                        <GradientStop Color="Yellow" Offset="1"></GradientStop>
                    </LinearGradientBrush>
                </StackPanel.Background>
            </StackPanel>
        </Border>
        <Border BorderBrush="Black" BorderThickness="3" Margin="10" CornerRadius="3">
            <StackPanel>
                <Label HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="30">Miami Heat</Label>
                <WrapPanel ItemHeight="125">
                    <Image Stretch="Uniform" Source="Assets/7_heat.png"/>
                    <Image Stretch="Uniform" Source="Assets/13_heat.png"/>
                    <Image Stretch="Uniform" Source="Assets/14_heat.png"/>
                    <Image Stretch="Uniform" Source="Assets/22_heat.png"/>
                    <Image Stretch="Uniform" Source="Assets/99_heat.png"/>
                </WrapPanel>
                <StackPanel.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Black" Offset="0"></GradientStop>
                        <GradientStop Color="Red" Offset="1"></GradientStop>
                    </LinearGradientBrush>
                </StackPanel.Background>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
