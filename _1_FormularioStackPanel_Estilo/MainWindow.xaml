<Window x:Class="_1_FormularioStackPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_1_FormularioStackPanel"
        mc:Ignorable="d"
        Title="Formulario StackPanel" Height="300" Width="800"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight">
        <Window.Resources>
            <Style TargetType="StackPanel">
                <Setter Property="Margin" Value="5"/>
            </Style>
            <Style TargetType="StackPanel" x:Key="StackPanelAzul" BasedOn="{StaticResource {x:Type StackPanel}}">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush>
                            <GradientStop Offset="0.0" Color="CornflowerBlue"/>
                            <GradientStop Offset="1.0" Color="LightBlue"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="StackPanel" x:Key="StackPanelVerde" BasedOn="{StaticResource {x:Type StackPanel}}">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush>
                            <GradientStop Offset="0.0" Color="Green"/>
                            <GradientStop Offset="1.0" Color="LightGreen"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="StackPanel" x:Key="StackPanelMorado" BasedOn="{StaticResource {x:Type StackPanel}}">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush>
                            <GradientStop Offset="0.0" Color="Magenta"/>
                            <GradientStop Offset="1.0" Color="LightPink"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="StackPanel" x:Key="StackPanelBotones" BasedOn="{StaticResource {x:Type StackPanel}}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Orientation" Value="Horizontal"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="5"></Setter>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontWeight" Value="Bold"></Setter>
                <Setter Property="FontSize" Value="16"></Setter>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Width" Value="100"></Setter>
                <Setter Property="Margin" Value="7"></Setter>
            </Style>
        </Window.Resources>
    <Grid>
        <StackPanel>
            <StackPanel Style="{StaticResource StackPanelAzul}">
                <Label>Nombre</Label>
                <TextBox/>
            </StackPanel>
            <StackPanel Style="{StaticResource StackPanelVerde}">
                <Label>Dirección</Label>
                <TextBox/>
            </StackPanel>
            <StackPanel Style="{StaticResource StackPanelMorado}">
                <Label>Correo electrónico</Label>
                <TextBox/>
            </StackPanel>
            <StackPanel Style="{StaticResource StackPanelBotones}">
                <Button>Aceptar</Button>
                <Button>Cancelar</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
